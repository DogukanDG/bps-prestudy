+    /**
+     * Registry of distributions that depend on which resource performs the task.
+     *
+     * Empty unless a plugin fills it. Scylla's own model gives an activity a
+     * single duration; process models discovered from event logs frequently do
+     * not, so a plugin can register per-resource alternatives here and they are
+     * consulted when the performing resource is known.
+     *
+     * Keyed by node id, then by resource id.
+     */
+    private final Map<Integer, Map<String, NumericalDist<?>>> resourceDistributions =
+            new HashMap<Integer, Map<String, NumericalDist<?>>>();
+
+    public Map<Integer, Map<String, NumericalDist<?>>> getResourceDistributions() {
+        return resourceDistributions;
+    }
+
+    /**
+     * Draw a duration for a node, preferring a distribution registered for one
+     * of the resources actually performing it.
+     *
+     * Falls back to {@link #getDistributionSample(Integer)} when no plugin has
+     * registered anything for this node, so default behaviour is unchanged.
+     *
+     * @param nodeId      the node
+     * @param resourceIds ids of the assigned resources, may be null or empty
+     */
+    public double getDistributionSample(Integer nodeId, Collection<String> resourceIds) {
+        Map<String, NumericalDist<?>> perResource = resourceDistributions.get(nodeId);
+        if (perResource == null || perResource.isEmpty() || resourceIds == null) {
+            return getDistributionSample(nodeId);
+        }
+
+        for (String resourceId : resourceIds) {
+            NumericalDist<?> distribution = perResource.get(resourceId);
+            if (distribution == null && resourceId != null) {
+                // Scylla identifies a running resource by its instance name. A
+                // plugin that pools several resources into one dynamicResource
+                // can encode the original id after a separator, so try that too
+                // before falling back.
+                int index = resourceId.lastIndexOf("__");
+                if (index >= 0) {
+                    distribution = perResource.get(resourceId.substring(index + 2));
+                }
+            }
+            if (distribution != null) {
+                double value = distribution.sample().doubleValue();
+                return value < 0 ? 0 : value;
+            }
+        }
+
+        return getDistributionSample(nodeId);
+    }
