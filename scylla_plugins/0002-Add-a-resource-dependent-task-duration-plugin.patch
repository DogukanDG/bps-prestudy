+package de.hpi.bpt.scylla.plugin.resourceduration;
+
+import java.util.HashMap;
+import java.util.Map;
+
+import org.jdom2.Element;
+import org.jdom2.Namespace;
+
+import de.hpi.bpt.scylla.exception.ScyllaValidationException;
+import de.hpi.bpt.scylla.logger.DebugLogger;
+import de.hpi.bpt.scylla.model.configuration.SimulationConfiguration;
+import de.hpi.bpt.scylla.model.configuration.distribution.TimeDistributionWrapper;
+import de.hpi.bpt.scylla.model.process.ProcessModel;
+import de.hpi.bpt.scylla.parser.SimulationConfigurationParser;
+import de.hpi.bpt.scylla.plugin_type.parser.SimulationConfigurationParserPluggable;
+
+/**
+ * Parses {@code <resourceDurations>} out of a task in the simulation
+ * configuration.
+ *
+ * <pre>
+ * &lt;task id="..."&gt;
+ *   &lt;duration timeUnit="SECONDS"&gt;...&lt;/duration&gt;          &lt;!-- fallback --&gt;
+ *   &lt;resourceDurations&gt;
+ *     &lt;resourceDuration resourceId="10125" timeUnit="SECONDS"&gt;
+ *       &lt;exponentialDistribution&gt;&lt;mean&gt;67&lt;/mean&gt;&lt;/exponentialDistribution&gt;
+ *     &lt;/resourceDuration&gt;
+ *   &lt;/resourceDurations&gt;
+ * &lt;/task&gt;
+ * </pre>
+ *
+ * The distribution shape is whatever Scylla already understands, parsed by its
+ * own parser, so no new distribution types are introduced here.
+ */
+public class ResourceDurationSCParserPlugin extends SimulationConfigurationParserPluggable {
+
+    @Override
+    public String getName() {
+        return ResourceDurationPluginUtils.PLUGIN_NAME;
+    }
+
+    @Override
+    public Map<String, Object> parse(SimulationConfiguration simulationInput, Element sim)
+            throws ScyllaValidationException {
+
+        Map<Integer, Map<String, TimeDistributionWrapper>> durations =
+                new HashMap<Integer, Map<String, TimeDistributionWrapper>>();
+        Namespace simNamespace = sim.getNamespace();
+        ProcessModel processModel = simulationInput.getProcessModel();
+
+        for (Element el : sim.getChildren()) {
+            String elementName = el.getName();
+            // Scylla accepts "task" and anything ending in "Task"; mirror that.
+            if (!"task".equals(elementName) && !elementName.endsWith("Task")) {
+                continue;
+            }
+
+            Element wrapper = el.getChild(ResourceDurationPluginUtils.ELEMENT_NAME, simNamespace);
+            if (wrapper == null) {
+                continue;
+            }
+
+            String identifier = el.getAttributeValue("id");
+            if (identifier == null) {
+                DebugLogger.log("Task with resource durations has no identifier, skip.");
+                continue;
+            }
+
+            Integer nodeId = processModel.getIdentifiersToNodeIds().get(identifier);
+            if (nodeId == null) {
+                DebugLogger.log("Task " + identifier + " is not in the process model, skip its resource durations.");
+                continue;
+            }
+
+            Map<String, TimeDistributionWrapper> perResource =
+                    new HashMap<String, TimeDistributionWrapper>();
+
+            for (Element item : wrapper.getChildren(
+                    ResourceDurationPluginUtils.ITEM_ELEMENT_NAME, simNamespace)) {
+
+                String resourceId = item.getAttributeValue(
+                        ResourceDurationPluginUtils.RESOURCE_ID_ATTRIBUTE);
+                if (resourceId == null) {
+                    throw new ScyllaValidationException("A resourceDuration of task " + identifier
+                            + " has no " + ResourceDurationPluginUtils.RESOURCE_ID_ATTRIBUTE + " attribute.");
+                }
+                if (item.getAttributeValue("timeUnit") == null) {
+                    // Scylla's own parser throws a NullPointerException here
+                    // rather than a readable error, so check it first.
+                    throw new ScyllaValidationException("The resourceDuration for " + resourceId
+                            + " of task " + identifier + " has no timeUnit.");
+                }
+
+                perResource.put(resourceId,
+                        SimulationConfigurationParser.getTimeDistributionWrapper(item, simNamespace));
+            }
+
+            if (!perResource.isEmpty()) {
+                durations.put(nodeId, perResource);
+            }
+        }
+
+        Map<String, Object> extensionAttributes = new HashMap<String, Object>();
+        extensionAttributes.put(ResourceDurationPluginUtils.RESOURCE_DURATIONS_KEY, durations);
+        return extensionAttributes;
+    }
+}
