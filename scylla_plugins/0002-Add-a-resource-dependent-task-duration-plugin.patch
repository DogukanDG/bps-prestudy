+package de.hpi.bpt.scylla.plugin.resourceduration;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Map.Entry;
+
+import de.hpi.bpt.scylla.model.configuration.SimulationConfiguration;
+import de.hpi.bpt.scylla.model.configuration.distribution.Distribution;
+import de.hpi.bpt.scylla.model.configuration.distribution.TimeDistributionWrapper;
+import de.hpi.bpt.scylla.model.process.ProcessModel;
+import de.hpi.bpt.scylla.plugin_type.simulation.DistributionConversionPluggable;
+import de.hpi.bpt.scylla.simulation.ProcessSimulationComponents;
+import de.hpi.bpt.scylla.simulation.SimulationModel;
+import de.hpi.bpt.scylla.simulation.utils.SimulationUtils;
+import desmoj.core.dist.NumericalDist;
+
+/**
+ * Turns the parsed per-resource durations into DESMO-J distributions and
+ * registers them where the simulation will look for them.
+ *
+ * The registry lives on ProcessSimulationComponents rather than in this
+ * plugin's own extension map, because TaskBeginEvent consults it directly when
+ * drawing a duration -- the assigned resource is known there, and that is the
+ * only point at which it is.
+ */
+public class ResourceDurationDistributionConversionPlugin extends DistributionConversionPluggable {
+
+    @Override
+    public String getName() {
+        return ResourceDurationPluginUtils.PLUGIN_NAME;
+    }
+
+    @SuppressWarnings("unchecked")
+    @Override
+    public Map<Integer, Object> convertToDesmoJDistributions(ProcessSimulationComponents pSimComponents) {
+
+        SimulationConfiguration simulationConfiguration = pSimComponents.getSimulationConfiguration();
+        Object stored = simulationConfiguration.getExtensionValue(
+                getName(), ResourceDurationPluginUtils.RESOURCE_DURATIONS_KEY);
+        if (stored == null) {
+            return new HashMap<Integer, Object>();
+        }
+
+        Map<Integer, Map<String, TimeDistributionWrapper>> parsed =
+                (Map<Integer, Map<String, TimeDistributionWrapper>>) stored;
+
+        Long randomSeed = simulationConfiguration.getRandomSeed();
+        ProcessModel processModel = pSimComponents.getProcessModel();
+        SimulationModel model = pSimComponents.getModel();
+        boolean showInReport = model.reportIsOn();
+        boolean showInTrace = model.traceIsOn();
+
+        for (Entry<Integer, Map<String, TimeDistributionWrapper>> perNode : parsed.entrySet()) {
+            Integer nodeId = perNode.getKey();
+            Map<String, NumericalDist<?>> converted = new HashMap<String, NumericalDist<?>>();
+
+            for (Entry<String, TimeDistributionWrapper> perResource : perNode.getValue().entrySet()) {
+                String resourceId = perResource.getKey();
+                Distribution distribution = perResource.getValue().getDistribution();
+                String name = processModel.getModelScopeId() + "_" + nodeId + "_" + resourceId;
+
+                try {
+                    NumericalDist<?> desmojDist = SimulationUtils.getDistribution(
+                            distribution, model, name, nodeId, showInReport, showInTrace);
+                    if (randomSeed != null) {
+                        desmojDist.setSeed(randomSeed);
+                    }
+                    converted.put(resourceId, desmojDist);
+                }
+                catch (InstantiationException e) {
+                    e.printStackTrace();
+                }
+            }
+
+            if (!converted.isEmpty()) {
+                pSimComponents.getResourceDistributions().put(nodeId, converted);
+            }
+        }
+
+        // Nothing is returned through the extension mechanism: the durations are
+        // consulted by node and resource at sampling time, not by node alone.
+        return new HashMap<Integer, Object>();
+    }
+}
