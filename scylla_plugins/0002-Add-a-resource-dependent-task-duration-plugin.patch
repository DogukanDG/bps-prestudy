@@ -0,0 +1,56 @@
+package de.hpi.bpt.scylla.plugin.resourceduration;
+
+/**
+ * Magic strings for the resource-dependent duration plugin.
+ *
+ * Scylla gives an activity a single duration, independent of who performs it.
+ * Process models discovered by Simod in differentiated mode give every resource
+ * its own distribution per activity -- on BPIC 2012 up to 42 per activity, with
+ * the fastest and slowest more than a hundredfold apart. Collapsing them into
+ * one distribution loses that spread.
+ *
+ * This plugin reads per-resource distributions and uses the one belonging to
+ * the resource actually assigned. The node-level {@code <duration>} stays as a
+ * fallback, so a build without the plugin still runs the model.
+ */
+public class ResourceDurationPluginUtils {
+
+    /** Plugin name. */
+    public static final String PLUGIN_NAME = "resourceDuration";
+
+    /** Key under which the parsed per-resource durations are stored. */
+    public static final String RESOURCE_DURATIONS_KEY = "resourceDurations";
+
+    /** Element wrapping the per-resource durations, as a child of a task. */
+    public static final String ELEMENT_NAME = "resourceDurations";
+
+    /** Element holding one resource's distribution. */
+    public static final String ITEM_ELEMENT_NAME = "resourceDuration";
+
+    /** Attribute naming the resource a distribution belongs to. */
+    public static final String RESOURCE_ID_ATTRIBUTE = "resourceId";
+
+    /**
+     * Separator between a pool id and a resource id in an instance name.
+     *
+     * Scylla identifies a running resource by its instance name. When several
+     * real resources share one pool, the converter names the instances
+     * {@code <pool>__<resourceId>} so the original resource can be recovered
+     * here. Instance names without the separator are used as-is.
+     */
+    public static final String INSTANCE_NAME_SEPARATOR = "__";
+
+    /**
+     * Recovers the resource id from an instance name.
+     */
+    public static String resourceIdOf(String instanceName) {
+        if (instanceName == null) {
+            return null;
+        }
+        int index = instanceName.lastIndexOf(INSTANCE_NAME_SEPARATOR);
+        return index < 0 ? instanceName : instanceName.substring(index + INSTANCE_NAME_SEPARATOR.length());
+    }
+
+    private ResourceDurationPluginUtils() {
+    }
+}
