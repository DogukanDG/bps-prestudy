@@ -0,0 +1,130 @@
+package de.hpi.bpt.scylla.plugin.arrivalcalendar;
+
+import java.time.DayOfWeek;
+import java.time.LocalTime;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.jdom2.Element;
+import org.jdom2.Namespace;
+
+import de.hpi.bpt.scylla.exception.ScyllaValidationException;
+import de.hpi.bpt.scylla.logger.DebugLogger;
+import de.hpi.bpt.scylla.model.configuration.SimulationConfiguration;
+import de.hpi.bpt.scylla.model.global.resource.TimetableItem;
+import de.hpi.bpt.scylla.model.process.ProcessModel;
+import de.hpi.bpt.scylla.plugin_type.parser.SimulationConfigurationParserPluggable;
+import de.hpi.bpt.scylla.simulation.utils.DateTimeUtils;
+
+/**
+ * Parses {@code <arrivalCalendar>} out of a start event in the simulation
+ * configuration.
+ *
+ * <pre>
+ * &lt;startEvent id="..."&gt;
+ *   &lt;arrivalRate timeUnit="SECONDS"&gt;...&lt;/arrivalRate&gt;
+ *   &lt;arrivalCalendar&gt;
+ *     &lt;timetableItem from="MONDAY" to="MONDAY"
+ *                    beginTime="05:00:00" endTime="08:00:00"/&gt;
+ *   &lt;/arrivalCalendar&gt;
+ * &lt;/startEvent&gt;
+ * </pre>
+ *
+ * The item shape is deliberately the same as the global configuration's
+ * timetables, so the semantics are already familiar and the wrap-around
+ * handling below matches what resource calendars do.
+ */
+public class ArrivalCalendarSCParserPlugin extends SimulationConfigurationParserPluggable {
+
+    @Override
+    public String getName() {
+        return ArrivalCalendarPluginUtils.PLUGIN_NAME;
+    }
+
+    @Override
+    public Map<String, Object> parse(SimulationConfiguration simulationInput, Element sim)
+            throws ScyllaValidationException {
+
+        Map<Integer, List<TimetableItem>> calendars = new HashMap<Integer, List<TimetableItem>>();
+        Namespace simNamespace = sim.getNamespace();
+        ProcessModel processModel = simulationInput.getProcessModel();
+
+        for (Element el : sim.getChildren()) {
+            if (!"startEvent".equals(el.getName())) {
+                continue;
+            }
+
+            Element calendarElement = el.getChild(ArrivalCalendarPluginUtils.ELEMENT_NAME, simNamespace);
+            if (calendarElement == null) {
+                continue;
+            }
+
+            String identifier = el.getAttributeValue("id");
+            if (identifier == null) {
+                DebugLogger.log("Start event with an arrival calendar has no identifier, skip.");
+                continue;
+            }
+
+            Integer nodeId = processModel.getIdentifiersToNodeIds().get(identifier);
+            if (nodeId == null) {
+                DebugLogger.log("Start event " + identifier + " is not in the process model, skip its calendar.");
+                continue;
+            }
+
+            List<TimetableItem> items = parseItems(calendarElement, simNamespace, identifier);
+            if (items.isEmpty()) {
+                throw new ScyllaValidationException(
+                        "Arrival calendar of start event " + identifier + " has no usable time windows.");
+            }
+            calendars.put(nodeId, items);
+        }
+
+        Map<String, Object> extensionAttributes = new HashMap<String, Object>();
+        extensionAttributes.put(ArrivalCalendarPluginUtils.ARRIVAL_CALENDAR_KEY, calendars);
+        return extensionAttributes;
+    }
+
+    /**
+     * Reads the windows, splitting any that wrap past Sunday.
+     *
+     * Mirrors GlobalConfigurationParser's handling of timetables: a window from
+     * FRIDAY to MONDAY becomes two, so that every item runs forwards through the
+     * week. Zero-length windows are dropped rather than rejected, matching the
+     * same code.
+     */
+    private List<TimetableItem> parseItems(Element calendarElement, Namespace simNamespace, String identifier)
+            throws ScyllaValidationException {
+
+        List<TimetableItem> items = new ArrayList<TimetableItem>();
+
+        for (Element itemElement : calendarElement.getChildren(
+                ArrivalCalendarPluginUtils.ITEM_ELEMENT_NAME, simNamespace)) {
+            try {
+                DayOfWeek weekdayFrom = DayOfWeek.valueOf(itemElement.getAttributeValue("from"));
+                DayOfWeek weekdayTo = DayOfWeek.valueOf(itemElement.getAttributeValue("to"));
+                LocalTime beginTime = LocalTime.parse(itemElement.getAttributeValue("beginTime"));
+                LocalTime endTime = LocalTime.parse(itemElement.getAttributeValue("endTime"));
+
+                if (DateTimeUtils.compareWeekdayTime(weekdayFrom, beginTime, weekdayTo, endTime) == 0) {
+                    continue; // zero-length window
+                }
+
+                if (weekdayFrom.compareTo(weekdayTo) > 0) { // e.g. FRIDAY to MONDAY
+                    items.add(new TimetableItem(weekdayFrom, DayOfWeek.SUNDAY, beginTime, LocalTime.MAX));
+                    items.add(new TimetableItem(DayOfWeek.MONDAY, weekdayTo, LocalTime.MIN, endTime));
+                }
+                else {
+                    items.add(new TimetableItem(weekdayFrom, weekdayTo, beginTime, endTime));
+                }
+            }
+            catch (NullPointerException | IllegalArgumentException e) {
+                throw new ScyllaValidationException("Arrival calendar of start event " + identifier
+                        + " has a timetableItem with a missing or malformed from/to/beginTime/endTime.");
+            }
+        }
+
+        return items;
+    }
+}
