+package de.hpi.bpt.scylla.plugin.arrivalcalendar;
+
+/**
+ * Magic strings for the arrival calendar plugin.
+ *
+ * Scylla schedules case arrivals from an inter-arrival distribution alone, with
+ * no notion of when arrivals are possible. Process models discovered by Simod
+ * carry an arrival calendar as well -- on BPIC 2012 it covers 75 hours a week,
+ * about 45% of it -- and ignoring it releases the same number of cases across
+ * the whole week instead. Since resource calendars still apply, those cases
+ * arrive when nobody is working and queue until the next shift, which inflates
+ * cycle time substantially.
+ *
+ * This plugin restricts arrivals to the hours the calendar covers.
+ */
+public class ArrivalCalendarPluginUtils {
+
+    /** Plugin name. */
+    public static final String PLUGIN_NAME = "arrivalCalendar";
+
+    /** Key under which the parsed calendar is stored as a simulation extension. */
+    public static final String ARRIVAL_CALENDAR_KEY = "arrivalCalendar";
+
+    /** Element holding the calendar, as a child of a startEvent. */
+    public static final String ELEMENT_NAME = "arrivalCalendar";
+
+    /** Element holding one open window, mirroring the global config's timetables. */
+    public static final String ITEM_ELEMENT_NAME = "timetableItem";
+
+    private ArrivalCalendarPluginUtils() {
+    }
+}
