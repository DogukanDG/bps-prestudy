@@ -0,0 +1,129 @@
+package de.hpi.bpt.scylla.plugin.arrivalcalendar;
+
+import java.time.ZonedDateTime;
+import java.time.temporal.TemporalAdjusters;
+import java.util.List;
+import java.util.Map;
+
+import de.hpi.bpt.scylla.exception.ScyllaRuntimeException;
+import de.hpi.bpt.scylla.model.global.resource.TimetableItem;
+import de.hpi.bpt.scylla.model.process.ProcessModel;
+import de.hpi.bpt.scylla.plugin_type.simulation.event.ProcessInstanceGenerationEventPluggable;
+import de.hpi.bpt.scylla.simulation.ProcessInstance;
+import de.hpi.bpt.scylla.simulation.ProcessSimulationComponents;
+import de.hpi.bpt.scylla.simulation.SimulationModel;
+import de.hpi.bpt.scylla.simulation.event.ProcessInstanceGenerationEvent;
+import de.hpi.bpt.scylla.simulation.utils.DateTimeUtils;
+import desmoj.core.simulator.TimeInstant;
+import desmoj.core.simulator.TimeSpan;
+
+/**
+ * Defers a case that would arrive outside the arrival calendar to the next open
+ * window.
+ *
+ * <b>Deferring, not dropping.</b> A case whose draw lands on a Sunday night is
+ * pushed to Monday morning rather than discarded. That keeps the number of
+ * simulated cases equal to {@code processInstances}, which is what makes runs
+ * comparable across engines and across configurations -- Prosimos compresses
+ * the same case count into the open hours, so this is the closer match.
+ *
+ * The cost is that arrivals cluster slightly at the start of each window, so
+ * the realised inter-arrival distribution is not exactly the configured one.
+ * That is inherent to the choice and belongs in any write-up of the results.
+ *
+ * The calendar arithmetic is not new: DateTimeUtils already locates the current
+ * or next window for resource calendars, and this reuses it.
+ */
+public class ArrivalCalendarSchedulingPlugin extends ProcessInstanceGenerationEventPluggable {
+
+    @Override
+    public String getName() {
+        return ArrivalCalendarPluginUtils.PLUGIN_NAME;
+    }
+
+    @SuppressWarnings("unchecked")
+    @Override
+    public void eventRoutine(ProcessInstanceGenerationEvent event, ProcessInstance processInstance)
+            throws ScyllaRuntimeException {
+
+        SimulationModel model = (SimulationModel) event.getModel();
+        ProcessSimulationComponents components = model.getDesmojObjectsMap().get(event.getProcessId());
+        if (components == null) {
+            return;
+        }
+
+        Object stored = components.getSimulationConfiguration()
+                .getExtensionValue(getName(), ArrivalCalendarPluginUtils.ARRIVAL_CALENDAR_KEY);
+        if (stored == null) {
+            return; // no calendar configured: leave Scylla's behaviour untouched
+        }
+
+        Map<Integer, List<TimetableItem>> calendars = (Map<Integer, List<TimetableItem>>) stored;
+        if (calendars.isEmpty()) {
+            return;
+        }
+
+        Integer startNodeId;
+        try {
+            ProcessModel processModel = components.getProcessModel();
+            startNodeId = processModel.getStartNode();
+        }
+        catch (Exception e) {
+            return; // no single start node; nothing to restrict
+        }
+
+        List<TimetableItem> calendar = calendars.get(startNodeId);
+        if (calendar == null || calendar.isEmpty()) {
+            return;
+        }
+
+        // The arrival is scheduled at present time plus this offset, so the
+        // instant to test is the two combined.
+        TimeSpan offset = event.getTimeSpanToStartEvent();
+        double offsetTime = offset == null ? 0d : offset.getTimeAsDouble();
+        TimeInstant arrival = new TimeInstant(model.presentTime().getTimeAsDouble() + offsetTime);
+
+        double delay = delayIntoNextWindow(arrival, calendar);
+        if (delay > 0d) {
+            event.setTimeSpanToStartEvent(new TimeSpan(offsetTime + delay));
+        }
+    }
+
+    /**
+     * How long the given instant must wait before the calendar is open, in the
+     * simulation's reference time unit. Zero when it is already inside a window.
+     *
+     * The delay is computed here rather than through
+     * DateTimeUtils.getTimeTableIndexWithinOrNext, which ranks windows by
+     * getNextOrSameZonedDateTime and so can pick one whose start already passed
+     * earlier the same day -- that yields a negative duration and lets arrivals
+     * through outside the calendar. This walks forward instead, so every
+     * candidate is strictly in the future.
+     */
+    static double delayIntoNextWindow(TimeInstant arrival, List<TimetableItem> calendar) {
+        ZonedDateTime dateTime = DateTimeUtils.getDateTime(arrival);
+
+        for (TimetableItem item : calendar) {
+            if (DateTimeUtils.isWithin(dateTime, item)) {
+                return 0d;
+            }
+        }
+
+        double best = Double.MAX_VALUE;
+        for (TimetableItem item : calendar) {
+            ZonedDateTime opening = dateTime
+                    .with(TemporalAdjusters.nextOrSame(item.getWeekdayFrom()))
+                    .with(item.getBeginTime());
+            if (!opening.isAfter(dateTime)) {
+                // Already past today: the next occurrence is a week later.
+                opening = opening.plusWeeks(1);
+            }
+            double delay = DateTimeUtils.getReferenceChronoUnit().between(dateTime, opening);
+            if (delay > 0d && delay < best) {
+                best = delay;
+            }
+        }
+
+        return best == Double.MAX_VALUE ? 0d : best;
+    }
+}
